# Base Neon — projet "one-love", région UNION EUROPÉENNE (Francfort ou Paris).
# L'association est française et traite des données de mineurs : ne jamais
# créer la base en us-east-1, qui est la région proposée par défaut.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signature des cookies de session du logiciel de gestion (/gestion).
# Chaîne aléatoire de 64 caractères hexadécimaux : openssl rand -hex 32
SESSION_SECRET=""

# URL publique du site, sans slash final. Indispensable aux aperçus de partage
# et au sitemap. Sur Vercel : type "Configuration", JAMAIS "Sensible", valeur
# non vide et sans retour à la ligne final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pièces justificatives, documents et photos (Vercel Blob, accès privé).
# Sans jeton, les fichiers sont écrits dans ./storage en local.
BLOB_READ_WRITE_TOKEN=""

# E-mails transactionnels (Resend). Sans ces deux variables, rien n'est envoyé
# et l'interface le signale plutôt que d'échouer en silence.
# EMAIL_FROM doit utiliser un domaine vérifié dans Resend. Pour ne pas casser
# le SPF de Google Workspace déjà en place sur associationonelove.org, vérifier
# un SOUS-DOMAINE dédié. Exemple :
#   EMAIL_FROM="One Love <contact@send.associationonelove.org>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Paiements en ligne (jalon 4). Comptes à ouvrir par le représentant légal de
# l'association — ne jamais coller de clé réelle dans une conversation.

# Stripe : carte, prélèvement SEPA, virement géré par Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# SerdiPay : Mobile Money local en RDC.
SERDIPAY_API_KEY=""
SERDIPAY_WEBHOOK_SECRET=""
